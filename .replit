[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 JWT_SECRET=hapa_local_dev_secret OWNER_PASSWORD=LocalDev2024 OWNER_NAME='HAPA Owner' node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
