
# Private documents (never committed, never publicly served)
var/private-documents/

# Public media local storage (never committed, served only via sanitized routes)
var/public-media/

# Dependencies
node_modules/

# Native build outputs & local tool state (projects themselves ARE committed)
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/capacitor-cordova-android-plugins/build/
ios/App/Pods/
ios/App/App/public/
ios/App/output/
ios/DerivedData/
*.keystore
*.jks
*.mobileprovision
*.p12
*.p8
android/app/google-services.json
ios/App/App/GoogleService-Info.plist
# Generated by `npx cap sync` (regenerate at build time)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
